# Environment Mode
NODE_ENV=development
PORT=5000

# PostgreSQL Connection String (e.g. postgresql://user:password@localhost:5432/sweety_db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sweety_db

# JWT Secret for Session/Auth Tokens
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin for Frontend
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Application Timezone
APP_TIMEZONE=Asia/Kolkata
